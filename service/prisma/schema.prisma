generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===================== C 端用户 =====================

model User {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  username      String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  email         String?  @db.VarChar(255)
  phone_number  String?  @db.VarChar(20)
  avatar_url    String?  @db.VarChar(255)
  status        String   @default("NORMAL") @db.VarChar(20)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  relation      UserRelation?
  promotion_link PromotionLink?
  wallets       Wallet[]
  orders        Order[]

  @@map("users")
}

model UserRelation {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id        Int      @unique @db.UnsignedInt
  parent_user_id Int      @db.UnsignedInt
  level          Int
  path           String   @db.VarChar(255)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([parent_user_id])
  @@map("user_relations")
}

model RealnameAuth {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int      @unique @db.UnsignedInt
  real_name   String   @db.VarChar(50)
  id_card     String   @db.VarChar(100)
  auth_status String   @default("PENDING") @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("realname_auths")
}

model PromotionLink {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int      @unique @db.UnsignedInt
  invite_code String   @unique @db.VarChar(32)
  status      String   @default("ACTIVE") @db.VarChar(20)
  reset_at    DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("promotion_links")
}

// ===================== 产品 & 订单 =====================

model Product {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  yield_rate   Decimal  @db.Decimal(10, 4)
  cycle_days   Int
  min_amount   Decimal  @db.Decimal(15, 2)
  max_amount   Decimal? @db.Decimal(15, 2)
  status       String   @default("DRAFT") @db.VarChar(20)
  rule_version String?  @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  deleted_at   DateTime?

  orders Order[]

  @@map("products")
}

model Order {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  order_no      String   @unique @db.VarChar(64)
  user_id       Int      @db.UnsignedInt
  product_id    Int      @db.UnsignedInt
  amount        Decimal  @db.Decimal(15, 2)
  profit        Decimal? @db.Decimal(15, 2)
  reward_amount Decimal? @db.Decimal(15, 2)
  status        String   @default("PENDING") @db.VarChar(20)
  start_date    DateTime?
  end_date      DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@index([user_id, status])
  @@map("orders")
}

// ===================== 分润 =====================

model Commission {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  biz_type       String    @db.VarChar(50)
  biz_id         String    @db.VarChar(100)
  event_id       String?   @db.VarChar(100)
  from_user_id   Int       @db.UnsignedInt
  to_user_id     Int       @db.UnsignedInt
  relation_level Int
  amount         Decimal   @db.Decimal(15, 2)
  status         String    @default("PENDING") @db.VarChar(20)
  rule_snapshot  String?   @db.Text
  settled_at     DateTime?
  paid_at        DateTime?
  manual_flag    Boolean   @default(false)
  reverse_of     Int?      @db.UnsignedInt
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@unique([biz_id, biz_type, to_user_id, relation_level])
  @@index([to_user_id, status])
  @@map("commissions")
}

model CommissionRule {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @db.VarChar(100)
  version      String    @db.VarChar(50)
  config       String    @db.Text
  status       String    @default("ACTIVE") @db.VarChar(20)
  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("commission_rules")
}

model InviteProgress {
  user_id      Int      @id @db.UnsignedInt
  valid_count  Int      @default(0)
  unlock_ratio Decimal  @default(0) @db.Decimal(5, 4)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("invite_progress")
}

model ValidInvite {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  inviter_user_id Int      @db.UnsignedInt
  invitee_user_id Int      @unique @db.UnsignedInt
  order_id        Int      @db.UnsignedInt
  created_at      DateTime @default(now())

  @@unique([inviter_user_id, invitee_user_id])
  @@map("valid_invites")
}

// ===================== 资金 =====================

model Wallet {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id           Int      @db.UnsignedInt
  type              String   @default("BALANCE") @db.VarChar(20)
  balance_available Decimal  @default(0) @db.Decimal(15, 2)
  balance_frozen    Decimal  @default(0) @db.Decimal(15, 2)
  version           Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user   User        @relation(fields: [user_id], references: [id])
  logs   WalletLog[]
  withdraws Withdraw[]

  @@unique([user_id, type])
  @@map("wallets")
}

model WalletLog {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  wallet_id       Int      @db.UnsignedInt
  user_id         Int      @db.UnsignedInt
  type            String   @db.VarChar(20)
  wallet_type     String   @db.VarChar(20)
  reference_id    String   @db.VarChar(100)
  reference_type  String   @db.VarChar(50)
  amount          Decimal  @db.Decimal(15, 2)
  balance_before  Decimal  @db.Decimal(15, 2)
  balance_after   Decimal  @db.Decimal(15, 2)
  description     String?  @db.VarChar(255)
  created_at      DateTime @default(now())

  wallet Wallet @relation(fields: [wallet_id], references: [id])

  @@index([user_id])
  @@index([reference_id, reference_type])
  @@map("wallet_logs")
}

model Withdraw {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id        Int      @db.UnsignedInt
  wallet_id      Int      @db.UnsignedInt
  amount         Decimal  @db.Decimal(15, 2)
  fee            Decimal  @default(0) @db.Decimal(15, 2)
  status         String   @default("PENDING") @db.VarChar(20)
  reason         String?  @db.VarChar(255)
  audit_admin_id Int?     @db.UnsignedInt
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  wallet Wallet @relation(fields: [wallet_id], references: [id])

  @@index([user_id, status])
  @@map("withdraws")
}

model RechargeOrder {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int      @db.UnsignedInt
  biz_id     String   @unique @db.VarChar(100)
  amount     Decimal  @db.Decimal(15, 2)
  status     String   @default("PENDING") @db.VarChar(20)
  channel    String?  @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@map("recharge_orders")
}

// ===================== 内容 =====================

model Banner {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  title      String    @db.VarChar(100)
  image_url  String    @db.VarChar(500)
  link_url   String?   @db.VarChar(500)
  status     String    @default("INACTIVE") @db.VarChar(20)
  sort_order Int       @default(0)
  start_time DateTime?
  end_time   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("banners")
}

model Article {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  title        String    @db.VarChar(200)
  content      String    @db.LongText
  tags         String?   @db.VarChar(255)
  description  String?   @db.VarChar(500)
  cover_image  String?   @db.VarChar(500)
  status       String    @default("DRAFT") @db.VarChar(20)
  sort_order   Int       @default(0)
  view_count   Int       @default(0)
  publish_time DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@map("articles")
}

// ===================== 管理端 RBAC =====================

model AdminUser {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  username        String    @unique @db.VarChar(50)
  password_hash   String    @db.VarChar(255)
  avatar          String?   @db.VarChar(255)
  status          String    @default("ACTIVE") @db.VarChar(20)
  last_login_ip   String?   @db.VarChar(50)
  last_login_time DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  roles AdminUserRole[]

  @@map("admin_users")
}

model SysRole {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  name       String   @db.VarChar(50)
  key        String   @unique @db.VarChar(50)
  status     String   @default("ACTIVE") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users AdminUserRole[]
  menus SysRoleMenu[]

  @@map("sys_roles")
}

model SysMenu {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  parent_id  Int      @default(0) @db.UnsignedInt
  name       String   @db.VarChar(50)
  type       Int      @default(1)
  path       String?  @db.VarChar(200)
  component  String?  @db.VarChar(255)
  permission String?  @db.VarChar(100)
  sort       Int      @default(0)
  visible    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  roles SysRoleMenu[]

  @@map("sys_menus")
}

model AdminUserRole {
  user_id Int @db.UnsignedInt
  role_id Int @db.UnsignedInt

  admin AdminUser @relation(fields: [user_id], references: [id])
  role  SysRole   @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
  @@map("admin_user_roles")
}

model SysRoleMenu {
  role_id Int @db.UnsignedInt
  menu_id Int @db.UnsignedInt

  role SysRole @relation(fields: [role_id], references: [id])
  menu SysMenu @relation(fields: [menu_id], references: [id])

  @@id([role_id, menu_id])
  @@map("sys_role_menus")
}

model AuditLog {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  admin_id    Int      @db.UnsignedInt
  action      String   @db.VarChar(100)
  target_type String   @db.VarChar(50)
  target_id   Int      @db.UnsignedInt
  reason      String?  @db.Text
  before_data String?  @db.Text
  after_data  String?  @db.Text
  created_at  DateTime @default(now())

  @@index([admin_id])
  @@map("audit_logs")
}

// ===================== 风控 =====================

model RiskRule {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  rule_type   String   @db.VarChar(50)
  threshold   String   @db.Text
  enabled     Boolean  @default(true)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("risk_rules")
}

model RiskEvent {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  rule_code  String   @db.VarChar(50)
  user_id    Int?     @db.UnsignedInt
  severity   String   @default("MEDIUM") @db.VarChar(20)
  status     String   @default("OPEN") @db.VarChar(20)
  detail     String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, status])
  @@index([rule_code, status])
  @@map("risk_events")
}
